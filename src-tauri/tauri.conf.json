{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAFBuilder by Joyjit Chowdhury",
  "version": "1.0.0",
  "identifier": "com.joyjitchowdhury.safbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAFBuilder by Joyjit Chowdhury",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Joyjit Chowdhury",
    "copyright": "Copyright (c) 2026 Joyjit Chowdhury. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "headerImage": "./windows/header.bmp",
        "sidebarImage": "./windows/sidebar.bmp"
      },
      "wix": {
        "bannerPath": "./windows/wix-banner.bmp",
        "dialogImagePath": "./windows/wix-dialog.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5MkQyMkNBNzFBQkQ5QzEKUldUQjJhdHh5aUl0dVJuVGsvK1BPTFlKRVBlUEttUkNERFNQQ1ZCczZielpkUTZBNytjUWxsbDMK",
      "endpoints": [
        "https://github.com/jcasdeveloper/dspace-saf-builder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
